{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlassSuite",
  "version": "0.1.0",
  "identifier": "com.glasssuite.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm -r build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEODZBNEM1MTIyMEMyMzQKUldRMHdpQVN4YVNHN1J0ZFlwNGtEVEw4cjNsYVJESUd1ZHl3TXA2K3FZdVFTUDhyRXpmKzkyd2cK",
      "endpoints": [],
      "requireSignedVersion": true
    }
  }
}
